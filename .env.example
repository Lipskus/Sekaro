# ============================================================
# Sekaro – Environment Configuration
# Copy this file to `.env` and fill in the values below.
# Most runtime settings are managed through the Settings page
# in the web UI after startup.
# ============================================================

# ── Infrastructure ───────────────────────────────────────────

# Domain for the self-hosted setup (used by Caddy for automatic HTTPS).
# Leave blank for local / HTTP-only use (http://localhost).
# Set to your domain (e.g. myapp.com) on a VPS for automatic Let's Encrypt certs.
CADDY_HOST=

# Application base URL (used for links, tracking callbacks, etc.)
BASE_URL=http://localhost:8000

# Stable JWT/API signing secret. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
QUICKLY_SECRET_KEY=

# Encrypts SMTP/IMAP passwords and Gmail OAuth tokens at rest.
# Set this BEFORE adding mailboxes on new production installations.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SEKARO_ENCRYPTION_KEY=

# PostgreSQL password used by docker-compose.sekaro.yml.
# Generate a long random value for production.
POSTGRES_PASSWORD=

# Local host port for the private Sekaro panel.
# Keep it bound to 127.0.0.1 and expose it through a reverse proxy / tunnel.
SEKARO_PORT=5050

# ── SMTP / IMAP inboxes ─────────────────────────────────────
# SMTP/IMAP credentials themselves are stored per-inbox via the UI or API
# (see INSTALL.md Step 3C). These flags only tune validation:
# Allow SMTP/IMAP hosts that resolve to private/internal addresses
# (self-hosted relays, Mailpit, local test doubles). Default: refuse.
# SMTP_ALLOW_PRIVATE_HOSTS=true
# Allow plaintext SMTP with neither STARTTLS nor implicit SSL (local
# relay doubles only — passwords go over the wire in cleartext). Default: refuse.
# SMTP_ALLOW_PLAIN_SMTP=true

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to localhost dev setup.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Vite Dev Server ──────────────────────────────────────────
# Extra hostnames Vite accepts in dev mode (comma-separated).
# Add your dev domain(s) here if you access the Vite dev server
# through a reverse proxy or custom hostname.
VITE_ALLOWED_HOSTS=
 
# only for tests and development 
# QUICKLY_MODE=development # development, production
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quickly

# Prebuilt Docker image sets QUICKLY_PREBUILT_IMAGE=1 (inbox UI uses Beacon for custom tracking hostnames).
# Host-Caddy / not-host compose sets QUICKLY_PREBUILT_IMAGE=0. Override with:
# QUICKLY_TRACKING_CNAME_UI=1   # show legacy CNAME-to-Sekaro tracking UI even on prebuilt image

# Public unsubscribe service (separate from the private application).
# Configure HTTPS origin; expose only /u/<token> on the public reverse proxy.
SEKARO_UNSUBSCRIBE_BASE_URL=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Private provisioning reads this; public process receives only its restricted DB login.
SEKARO_UNSUBSCRIBE_PASSWORD=
SEKARO_UNSUBSCRIBE_PORT=5051
# For restore only: restart app with 1, stop public service and other workers.
# SEKARO_MAINTENANCE=1

# Optional Gmail API (private administrator connection; see docs/STAGE_9_GMAIL.md).
# Google Cloud OAuth client type: Web application. Enable Gmail API.
# Authorized redirect URI: https://your-domain/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
