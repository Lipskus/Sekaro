FROM python:3.12-slim-trixie
WORKDIR /service
COPY public_unsubscribe/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY public_unsubscribe/ ./public_unsubscribe/
USER 65534:65534
EXPOSE 8000
CMD ["uvicorn", "public_unsubscribe.server:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
